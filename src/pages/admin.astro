---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin Rekap Pesanan">
  <!-- CDN Eksternal -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

  <style>
    header, nav {
      display: none !important;
    }
  </style>

  <div class="bg-[#0F051D] text-white min-h-screen p-4 md:p-8 font-sans">
    
    <!-- LOGIN FORM -->
    <div id="login-section" class="max-w-md mx-auto mt-20 bg-[#1A0B2E] border border-[#FF4B91]/30 rounded-3xl p-8 shadow-2xl text-center">
      <div class="text-5xl mb-4">🔐</div>
      <h1 class="text-2xl font-black text-[#FFD000] mb-2">Akses Rekap Admin</h1>
      <p class="text-xs text-[#C8B3E6] mb-6">Masukkan PIN untuk membuka rekap pesanan.</p>
      
      <form id="pin-form" class="space-y-4">
        <input 
          type="password" 
          id="pin-input" 
          placeholder="Masukkan PIN" 
          class="w-full bg-[#25133E] border border-[#FF4B91]/40 rounded-2xl px-4 py-3.5 text-center text-xl text-white font-bold focus:outline-none focus:border-[#FF4B91]"
          required
        />
        <button 
          type="submit" 
          class="w-full bg-[#FF4B91] hover:bg-[#ff2d7d] text-white font-extrabold py-3.5 rounded-2xl transition-all shadow-lg text-sm">
          Masuk ke Dashboard
        </button>
      </form>
    </div>

    <!-- DASHBOARD ADMIN -->
    <div id="admin-dashboard" class="max-w-5xl mx-auto hidden pt-4">
      
      <!-- Header Dashboard -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 bg-[#1A0B2E] border border-[#FF4B91]/30 p-6 rounded-3xl shadow-xl">
        <div>
          <h1 class="text-2xl font-black text-[#FFD000] flex items-center gap-2">
            📊 Rekap Pesanan Masuk
          </h1>
          <p class="text-xs text-[#C8B3E6] mt-1">Filter periode tanggal & download rekap PDF dengan total omset.</p>
        </div>
        
        <div class="flex flex-wrap gap-2 w-full md:w-auto">
          <button id="btn-refresh" class="bg-[#25133E] hover:bg-[#341b57] text-[#C8B3E6] px-4 py-2.5 rounded-xl text-xs font-bold transition-all border border-[#FF4B91]/30">
            🔄 Refresh
          </button>
          <button id="btn-pdf" class="bg-emerald-600 hover:bg-emerald-500 text-white px-5 py-2.5 rounded-xl text-xs font-bold transition-all shadow-lg">
            📄 Download PDF Rekapan
          </button>
          <button id="btn-logout" class="bg-rose-900/40 hover:bg-rose-900/80 text-rose-300 px-3.5 py-2.5 rounded-xl text-xs font-bold border border-rose-500/30">
            Keluar
          </button>
        </div>
      </div>

      <!-- KOTAK FILTER PERIODE TANGGAL -->
      <div class="bg-[#1A0B2E] border-2 border-[#FF4B91] p-5 rounded-2xl mb-6 shadow-xl">
        <div class="flex items-center justify-between mb-3">
          <p class="text-xs font-black text-[#FFD000] uppercase tracking-wider flex items-center gap-1.5">
            🔍 Filter Periode Tanggal Kirim
          </p>
          <span id="filter-indicator" class="text-[10px] bg-[#FF4B91]/20 text-[#FF80B5] px-2.5 py-1 rounded-full font-bold">
            Menampilkan Semua Data
          </span>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 items-end">
          <div>
            <label class="text-[11px] text-[#C8B3E6] block mb-1 font-semibold">Dari Tanggal:</label>
            <input type="date" id="filter-start" class="w-full bg-[#25133E] border border-[#FF4B91]/40 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#FF4B91]" />
          </div>
          <div>
            <label class="text-[11px] text-[#C8B3E6] block mb-1 font-semibold">Sampai Tanggal:</label>
            <input type="date" id="filter-end" class="w-full bg-[#25133E] border border-[#FF4B91]/40 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#FF4B91]" />
          </div>
          <div class="flex gap-2">
            <button id="btn-apply-filter" class="flex-1 bg-[#FF4B91] hover:bg-[#ff2d7d] text-white font-bold py-2 px-4 rounded-xl text-xs shadow-md">
              Terapkan Filter
            </button>
            <button id="btn-reset-filter" class="bg-[#25133E] hover:bg-[#341b57] text-[#C8B3E6] font-bold py-2 px-3 rounded-xl text-xs border border-[#FF4B91]/30">
              Reset
            </button>
          </div>
        </div>
      </div>

      <!-- Ringkasan Statistik -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-8">
        <div class="bg-[#1A0B2E] border border-[#FF4B91]/20 p-5 rounded-2xl">
          <p class="text-xs font-medium text-[#C8B3E6]">Total Pesanan (Filtered)</p>
          <p id="stat-total-orders" class="text-3xl font-black text-[#FFD000] mt-1">0</p>
        </div>
        <div class="bg-[#1A0B2E] border border-[#FF4B91]/20 p-5 rounded-2xl">
          <p class="text-xs font-medium text-[#C8B3E6]">Total Omset (Filtered)</p>
          <p id="stat-total-income" class="text-xl md:text-2xl font-black text-emerald-400 mt-1">Rp 0</p>
        </div>
        <div class="bg-[#1A0B2E] border border-[#FF4B91]/20 p-5 rounded-2xl col-span-2 md:col-span-1">
          <p class="text-xs font-medium text-[#C8B3E6]">Periode Terpilih</p>
          <p id="stat-date" class="text-xs font-bold text-white mt-2 leading-relaxed">Semua Data Pesanan</p>
        </div>
      </div>

      <!-- Daftar Pesanan -->
      <div class="space-y-5" id="orders-container">
        <p class="text-center text-[#8B74A8] py-12 italic">Memuat data pesanan...</p>
      </div>

    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const ADMIN_PIN = "123456";
      const SUPABASE_URL = "https://mnpoxmxslqrqsgcfbssv.supabase.co";
      const SUPABASE_KEY = "sb_publishable_a_BfJEtkxjstZ1rBucJMww_uVyO0XuR";

      let supabaseClient = null;
      if (window.supabase) {
        supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
      }

      const loginSection = document.getElementById('login-section');
      const adminDashboard = document.getElementById('admin-dashboard');
      const pinForm = document.getElementById('pin-form');
      const pinInput = document.getElementById('pin-input');
      const ordersContainer = document.getElementById('orders-container');

      const filterStart = document.getElementById('filter-start');
      const filterEnd = document.getElementById('filter-end');
      const filterIndicator = document.getElementById('filter-indicator');

      let rawOrders = [];
      let filteredOrders = [];

      if (sessionStorage.getItem('admin_authenticated') === 'true') {
        showDashboard();
      }

      pinForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (pinInput && pinInput.value === ADMIN_PIN) {
          sessionStorage.setItem('admin_authenticated', 'true');
          showDashboard();
        } else {
          alert('PIN Salah! Coba lagi ya.');
          if (pinInput) pinInput.value = '';
        }
      });

      document.getElementById('btn-logout')?.addEventListener('click', () => {
        sessionStorage.removeItem('admin_authenticated');
        window.location.reload();
      });

      document.getElementById('btn-refresh')?.addEventListener('click', () => {
        loadOrders();
      });

      document.getElementById('btn-apply-filter')?.addEventListener('click', () => {
        applyDateFilter();
      });

      document.getElementById('btn-reset-filter')?.addEventListener('click', () => {
        if (filterStart) filterStart.value = '';
        if (filterEnd) filterEnd.value = '';
        filteredOrders = [...rawOrders];
        renderOrders(filteredOrders);
        updateStats(filteredOrders, "Semua Data Pesanan");
        if (filterIndicator) filterIndicator.innerText = "Menampilkan Semua Data";
      });

      document.getElementById('btn-pdf')?.addEventListener('click', () => {
        generatePDF();
      });

      function showDashboard() {
        loginSection?.classList.add('hidden');
        adminDashboard?.classList.remove('hidden');
        loadOrders();
      }

      async function loadOrders() {
        if (!supabaseClient) {
          if (ordersContainer) ordersContainer.innerHTML = '<p class="text-center text-rose-400 py-8">Koneksi Supabase gagal dimuat.</p>';
          return;
        }

        if (ordersContainer) ordersContainer.innerHTML = '<p class="text-center text-[#8B74A8] py-8 italic">Mengambil data dari database...</p>';

        try {
          const { data, error } = await supabaseClient
            .from('pesanan')
            .select('*')
            .order('id', { ascending: false });

          if (error) throw error;

          rawOrders = data || [];
          filteredOrders = [...rawOrders];
          renderOrders(filteredOrders);
          updateStats(filteredOrders, "Semua Data Pesanan");
        } catch (err) {
          console.error(err);
          if (ordersContainer) ordersContainer.innerHTML = `<p class="text-center text-rose-400 py-8">Gagal mengambil data pesanan: ${err.message || err}</p>`;
        }
      }

      function applyDateFilter() {
        const startVal = filterStart?.value;
        const endVal = filterEnd?.value;

        if (!startVal && !endVal) {
          alert("Silakan pilih tanggal 'Dari' atau 'Sampai' terlebih dahulu!");
          return;
        }

        filteredOrders = rawOrders.filter(item => {
          if (!item.tanggal_kirim) return false;
          
          const match = item.tanggal_kirim.match(/\d{4}-\d{2}-\d{2}/);
          if (!match) return true; 

          const orderDate = match[0];

          if (startVal && endVal) {
            return orderDate >= startVal && orderDate <= endVal;
          } else if (startVal) {
            return orderDate >= startVal;
          } else if (endVal) {
            return orderDate <= endVal;
          }
          return true;
        });

        const labelText = `${startVal || 'Awal'} s/d ${endVal || 'Akhir'}`;
        if (filterIndicator) filterIndicator.innerText = `Filtered: ${labelText}`;
        renderOrders(filteredOrders);
        updateStats(filteredOrders, labelText);
      }

      function renderOrders(orders) {
        if (!ordersContainer) return;

        if (orders.length === 0) {
          ordersContainer.innerHTML = `
            <div class="bg-[#1A0B2E] p-8 rounded-2xl text-center border border-[#FF4B91]/20">
              <p class="text-gray-300 font-bold">Tidak ada pesanan pada periode tanggal ini.</p>
              <p class="text-xs text-[#C8B3E6] mt-1">Coba sesuaikan tanggal filter atau klik Reset.</p>
            </div>`;
          return;
        }

        let html = '';
        orders.forEach((item, index) => {
          html += `
            <div class="bg-[#1A0B2E] border border-[#FF4B91]/30 rounded-2xl p-6 shadow-xl relative overflow-hidden transition-all hover:border-[#FF4B91]/60">
              <div class="flex justify-between items-start mb-4 border-b border-[#FF4B91]/20 pb-3">
                <div>
                  <span class="text-xs bg-[#FF4B91]/30 text-[#FF80B5] px-3 py-1 rounded-full font-black tracking-wider">#${orders.length - index}</span>
                  <h3 class="text-xl font-black text-white mt-2">${item.nama || 'Tanpa Nama'}</h3>
                  <a href="https://wa.me/${(item.telepon || '').replace(/[^0-9]/g, '')}" target="_blank" class="text-xs text-[#FFD000] hover:underline font-bold inline-block mt-1">
                    📞 ${item.telepon || '-'} (Klik WA)
                  </a>
                </div>
                <div class="text-right">
                  <span class="text-[11px] text-[#C8B3E6] font-medium block">Waktu / Tgl Kirim:</span>
                  <span class="text-xs font-extrabold text-[#FFD000] bg-[#25133E] px-3 py-1.5 rounded-lg border border-[#FF4B91]/40 inline-block mt-1 shadow-inner">${item.tanggal_kirim || '-'}</span>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                  <p class="text-xs text-[#FF80B5] font-extrabold uppercase tracking-wider mb-1.5">🏠 Alamat Pengiriman:</p>
                  <p class="text-xs text-gray-200 bg-[#25133E]/70 p-3 rounded-xl border border-[#FF4B91]/20 leading-relaxed">${item.alamat || '-'}</p>
                </div>

                <div>
                  <p class="text-xs text-[#FF80B5] font-extrabold uppercase tracking-wider mb-1.5">🛒 Detail Pesanan:</p>
                  <p class="text-xs font-semibold text-white bg-[#25133E]/70 p-3 rounded-xl border border-[#FF4B91]/20 leading-relaxed">${item.pesanan || '-'}</p>
                </div>
              </div>

              <div class="flex justify-between items-center border-t border-[#FF4B91]/20 pt-4 mt-2">
                <span class="text-xs font-bold text-[#C8B3E6]">Total Pembayaran:</span>
                <span class="text-lg font-black text-[#FFD000] bg-[#25133E] px-3 py-1 rounded-lg border border-[#FFD000]/30">${item.total || 'Rp 0'}</span>
              </div>
            </div>
          `;
        });

        ordersContainer.innerHTML = html;
      }

      function updateStats(orders, periodeStr) {
        const totalOrdersEl = document.getElementById('stat-total-orders');
        const totalIncomeEl = document.getElementById('stat-total-income');
        const statDateEl = document.getElementById('stat-date');

        if (totalOrdersEl) totalOrdersEl.innerText = orders.length;

        let grandTotal = 0;
        orders.forEach(o => {
          if (o.total) {
            const num = parseInt(o.total.replace(/[^0-9]/g, '')) || 0;
            grandTotal += num;
          }
        });

        if (totalIncomeEl) totalIncomeEl.innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
        if (statDateEl) statDateEl.innerText = periodeStr;
      }

      function generatePDF() {
        if (filteredOrders.length === 0) {
          alert('Tidak ada data pesanan untuk di-download.');
          return;
        }

        const { jsPDF } = window.jspdf;
        // Penyesuaian 1: Mengubah mode ke Landscape (Mendatar)
        const doc = new jsPDF('landscape');
        const todayStr = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

        let grandTotal = 0;
        filteredOrders.forEach(o => {
          if (o.total) {
            const num = parseInt(o.total.replace(/[^0-9]/g, '')) || 0;
            grandTotal += num;
          }
        });

        // Penyesuaian 2: Header Laporan Keuangan Formal (Warna Slate Dark #1E293B)
        doc.setFont("helvetica", "bold");
        doc.setFontSize(15);
        doc.setTextColor(30, 41, 59);
        doc.text("LAPORAN REKAPITULASI PESANAN MASUK", 14, 16);
        
        doc.setFontSize(11);
        doc.setTextColor(71, 85, 105);
        doc.text("JAJANAN GEN Z BY MIMIN", 14, 22);

        // Penyesuaian 3: Garis Pembatas Header Formal
        doc.setDrawColor(203, 213, 225);
        doc.setLineWidth(0.5);
        doc.line(14, 25, 283, 25);

        // Ringkasan Teks Informasi
        doc.setFontSize(9);
        doc.setFont("helvetica", "normal");
        doc.setTextColor(71, 85, 105);
        doc.text(`Tanggal Cetak  : ${todayStr}`, 14, 32);
        doc.text(`Total Pesanan  : ${filteredOrders.length} Pesanan`, 14, 37);

        doc.setFont("helvetica", "bold");
        doc.setTextColor(15, 23, 42);

        const tableData = [];
        filteredOrders.forEach((item, index) => {
          tableData.push([
            index + 1,
            item.nama || '-',
            item.telepon || '-',
            item.tanggal_kirim || '-',
            item.pesanan || '-',
            item.alamat || '-',
            item.total || '-'
          ]);
        });

        // Penyesuaian 4: Footer Baris Total Laporan Formal
        tableData.push([
          { content: 'TOTAL PENJUALAN', colSpan: 6, styles: { halign: 'right', fontStyle: 'bold', fillColor: [241, 245, 249], textColor: [15, 23, 42] } },
          { content: `Rp ${grandTotal.toLocaleString('id-ID')}`, styles: { fontStyle: 'bold', fillColor: [241, 245, 249], textColor: [16, 185, 129], halign: 'right' } }
        ]);

        // Penyesuaian 5: Styling Tabel (Pemberian Lebar Kolom Presisi agar Tulisan Tidak Terpotong)
        doc.autoTable({
          startY: 42,
          head: [['No', 'Nama Pelanggan', 'No. Telp', 'Tanggal Kirim', 'Rincian Pesanan', 'Alamat Pengiriman', 'Total']],
          body: tableData,
          theme: 'grid',
          headStyles: { 
            fillColor: [30, 41, 59], // Dark Slate / Navy Formal
            textColor: [255, 255, 255], 
            fontStyle: 'bold',
            halign: 'center',
            valign: 'middle'
          },
          styles: { 
            fontSize: 8.5, 
            cellPadding: 3,
            textColor: [51, 65, 85],
            lineColor: [226, 232, 240],
            lineWidth: 0.1,
            valign: 'top'
          },
          columnStyles: {
            0: { cellWidth: 10, halign: 'center' }, // Kolom No (Melebarkan dari 8 ke 10 biar "No" tak terpotong)
            1: { cellWidth: 32 },                  // Nama
            2: { cellWidth: 30 },                  // No WA
            3: { cellWidth: 32 },                  // Waktu Kirim
            4: { cellWidth: 70 },                  // Detail Pesanan (Diberi ruang paling lega)
            5: { cellWidth: 65 },                  // Alamat Pengiriman
            6: { cellWidth: 30, fontStyle: 'bold', halign: 'right' } // Total
          }
        });

        doc.save(`Laporan_Rekap_Pesanan_${todayStr.replace(/\s+/g, '_')}.pdf`);
      }
    });
  </script>
</Layout>