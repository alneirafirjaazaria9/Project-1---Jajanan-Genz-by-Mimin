---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start font-['Fredoka'] text-[#F3E8FF]">
  
  <div class="lg:col-span-7 bg-[#24113B]/80 backdrop-blur-md p-5 rounded-3xl border border-[#FF4B91]/30 shadow-[0_0_25px_rgba(255,75,145,0.15)]">
    
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-3 border-b border-[#FF4B91]/20">
      <div>
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
          <span>🍿</span> Step 1: Pilih Jajanan
        </h2>
        <p class="text-xs text-[#C8B3E6] font-medium mt-0.5">
          Pilih varian & topping kesukaanmu, lalu klik (+)!
        </p>
      </div>
      
      <div class="flex bg-[#120722] p-1 rounded-full gap-1 border border-[#FF4B91]/30" id="filter-container">
        <button data-filter="all" class="filter-btn active-filter px-4 py-1.5 text-xs font-bold rounded-full bg-[#FF4B91] text-white shadow-[0_0_10px_#FF4B91] transition-all">All</button>
        <button data-filter="asin" class="filter-btn px-4 py-1.5 text-xs font-bold rounded-full text-[#C8B3E6] hover:text-white transition-all">Asin</button>
        <button data-filter="manis" class="filter-btn px-4 py-1.5 text-xs font-bold rounded-full text-[#C8B3E6] hover:text-white transition-all">Manis</button>
      </div>
    </div>

    <!-- Grid Produk -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {products.map((item) => (
        <div class="product-item bg-[#160B29]/80 hover:bg-[#1C0D35] p-4 rounded-2xl border border-[#FF4B91]/20 hover:border-[#FF4B91]/60 transition-all flex flex-col justify-between group shadow-lg" data-category={item.category}>
          <div>
            <!-- Box Gambar Produk -->
            <div class="relative bg-[#2D1647] rounded-xl h-36 flex items-center justify-center font-bold text-base text-[#FF93C4] mb-3 overflow-hidden text-center border border-[#FF4B91]/20">
              {item.image ? (
                <img 
                  src={item.image} 
                  alt={item.name} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <span class="z-10 px-2">{item.name}</span>
              )}

              {item.badge && (
                <span class="absolute top-2 right-2 bg-[#FF4B91] text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-[0_0_8px_#FF4B91] z-20">
                  {item.badge}
                </span>
              )}
            </div>

            <h3 class="font-bold text-white text-base leading-snug">{item.name}</h3>
            <p class="text-xs text-[#C8B3E6] mt-1 font-medium">{item.desc}</p>
            
            <!-- Pilihan Ukuran / Porsi -->
            {item.hasVariants && (
              <div class="mt-3 bg-[#24113B] p-2 rounded-xl border border-[#FF4B91]/30">
                <label class="block text-[11px] font-bold text-[#FF93C4] mb-1">Pilih Porsi / Ukuran:</label>
                <select id={`variant-select-${item.id}`} class="variant-select w-full p-1.5 text-xs font-bold rounded-lg bg-[#120722] text-white border border-[#FF4B91]/30 focus:outline-none focus:border-[#FF4B91]" data-id={item.id}>
                  {item.variants?.map((v) => (
                    <option value={v.id} data-price={v.price} data-name={`${item.name} (${v.name})`}>
                      Porsi {v.name} - Rp {v.price.toLocaleString("id-ID")}
                    </option>
                  ))}
                </select>
              </div>
            )}

            <!-- Pilihan Glaze & Topping -->
            {item.hasGlazeTopping && (
              <div class="mt-3 bg-[#24113B] p-2.5 rounded-xl border border-[#FF4B91]/30 space-y-2">
                <p class="text-[10px] text-[#FF93C4] font-semibold">*Bebas pilih glaze & topping favoritmu!</p>
                
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="block text-[10px] font-bold text-[#C8B3E6] mb-0.5">Glaze 1:</label>
                    <select id={`glaze1-select-${item.id}`} class="glaze-select w-full p-1 text-[11px] font-bold rounded-lg bg-[#120722] text-white border border-[#FF4B91]/30 focus:outline-none" data-id={item.id}>
                      <option value="">Tanpa Glaze</option>
                      <option value="Coklat">Coklat</option>
                      <option value="Tiramissu">Tiramissu</option>
                      <option value="Matcha">Matcha</option>
                      <option value="Strawberry">Strawberry</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-[10px] font-bold text-[#C8B3E6] mb-0.5">Glaze 2 (Opsional):</label>
                    <select id={`glaze2-select-${item.id}`} class="glaze-select w-full p-1 text-[11px] font-bold rounded-lg bg-[#120722] text-white border border-[#FF4B91]/30 focus:outline-none" data-id={item.id}>
                      <option value="">Tanpa Glaze</option>
                      <option value="Coklat">Coklat</option>
                      <option value="Tiramissu">Tiramissu</option>
                      <option value="Matcha">Matcha</option>
                      <option value="Strawberry">Strawberry</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label class="block text-[10px] font-bold text-[#C8B3E6] mb-1">Pilih Topping:</label>
                  <div class="grid grid-cols-2 gap-1.5 text-[11px]">
                    <label class="flex items-center gap-1.5 bg-[#120722] p-1 rounded-lg border border-[#FF4B91]/20 cursor-pointer">
                      <input type="checkbox" name={`topping-${item.id}`} value="Keju" class="topping-cb accent-[#FF4B91]" data-id={item.id} />
                      <span>Keju</span>
                    </label>
                    <label class="flex items-center gap-1.5 bg-[#120722] p-1 rounded-lg border border-[#FF4B91]/20 cursor-pointer">
                      <input type="checkbox" name={`topping-${item.id}`} value="Sprinkle" class="topping-cb accent-[#FF4B91]" data-id={item.id} />
                      <span>Sprinkle</span>
                    </label>
                    <label class="flex items-center gap-1.5 bg-[#120722] p-1 rounded-lg border border-[#FF4B91]/20 cursor-pointer">
                      <input type="checkbox" name={`topping-${item.id}`} value="Oreo" class="topping-cb accent-[#FF4B91]" data-id={item.id} />
                      <span>Oreo</span>
                    </label>
                    <label class="flex items-center gap-1.5 bg-[#120722] p-1 rounded-lg border border-[#FF4B91]/20 cursor-pointer">
                      <input type="checkbox" name={`topping-${item.id}`} value="Chochocips" class="topping-cb accent-[#FF4B91]" data-id={item.id} />
                      <span>Chochocips</span>
                    </label>
                  </div>
                </div>
              </div>
            )}

            <!-- Display Harga Live -->
            {!item.hasVariants && (
              <p id={`price-display-${item.id}`} class="text-sm font-black text-[#FFD000] mt-2 drop-shadow-[0_0_5px_rgba(255,208,0,0.5)]">
                Rp {item.price?.toLocaleString("id-ID")}
              </p>
            )}
          </div>

          <!-- Counter Qty -->
          <div class="flex items-center justify-between mt-4 bg-[#120722] p-1.5 rounded-xl border border-[#FF4B91]/30">
            <button 
              class="btn-minus w-8 h-8 rounded-lg bg-[#24113B] hover:bg-[#361B54] text-white font-bold transition-all active:scale-95 border border-[#FF4B91]/20" 
              data-id={item.id} 
              data-has-variant={item.hasVariants ? "true" : "false"}
              data-has-glaze={item.hasGlazeTopping ? "true" : "false"}>-</button>
            <span class="qty-count font-bold text-white text-sm" data-id={item.id}>0</span>
            <button 
              class="btn-plus w-8 h-8 rounded-lg bg-[#FF4B91] hover:bg-[#ff3381] text-white font-bold transition-all shadow-[0_0_10px_rgba(255,75,145,0.5)] active:scale-95" 
              data-id={item.id} 
              data-has-variant={item.hasVariants ? "true" : "false"}
              data-has-glaze={item.hasGlazeTopping ? "true" : "false"}>+</button>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="lg:col-span-5 bg-[#24113B]/80 backdrop-blur-md p-5 rounded-3xl border border-[#FF4B91]/30 shadow-[0_0_25px_rgba(255,75,145,0.15)] space-y-4">
    <div class="border-b border-[#FF4B91]/20 pb-3">
      <h2 class="text-xl font-bold text-white flex items-center gap-2">
        <span>📋</span> Step 2: Pesan Disini!
      </h2>
      <p class="text-xs text-[#C8B3E6] font-medium mt-0.5">
        Isi form pengiriman, lalu klik tombol WA buat checkout!
      </p>
    </div>

    <form id="order-form" class="space-y-3">
      <div>
        <label class="block text-xs font-bold text-[#FF93C4] mb-1">Nama Pemesan</label>
        <input type="text" id="custName" required placeholder="Nama kamu..." class="w-full px-3 py-2 text-sm rounded-xl border border-[#FF4B91]/30 bg-[#120722] text-white placeholder-[#8B74A8] focus:outline-none focus:border-[#FF4B91] focus:ring-1 focus:ring-[#FF4B91] transition-all" />
      </div>

      <div>
        <label class="block text-xs font-bold text-[#FF93C4] mb-1">Nomor Telepon</label>
        <input type="tel" id="custPhone" required placeholder="08xxxxxxxxxx" class="w-full px-3 py-2 text-sm rounded-xl border border-[#FF4B91]/30 bg-[#120722] text-white placeholder-[#8B74A8] focus:outline-none focus:border-[#FF4B91] focus:ring-1 focus:ring-[#FF4B91] transition-all" />
      </div>

      <div>
        <label class="block text-xs font-bold text-[#FF93C4] mb-1">Alamat Pemesanan</label>
        <textarea id="custAddress" required rows="2" placeholder="Jl. Raya No. 12..." class="w-full px-3 py-2 text-sm rounded-xl border border-[#FF4B91]/30 bg-[#120722] text-white placeholder-[#8B74A8] focus:outline-none focus:border-[#FF4B91] focus:ring-1 focus:ring-[#FF4B91] transition-all"></textarea>
      </div>

      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="block text-xs font-bold text-[#FF93C4] mb-1">Tanggal Kirim</label>
          <input type="date" id="orderDate" required class="w-full px-2 py-2 text-xs rounded-xl border border-[#FF4B91]/30 bg-[#120722] text-white focus:outline-none focus:border-[#FF4B91] transition-all" />
        </div>
        <div>
          <label class="block text-xs font-bold text-[#FF93C4] mb-1">Jam Kirim (WIB)</label>
          <select id="orderTime" required class="w-full px-2 py-2 text-xs rounded-xl border border-[#FF4B91]/30 bg-[#120722] text-white focus:outline-none focus:border-[#FF4B91] transition-all">
            <option value="">Pilih Jam</option>
            <option value="10:00">10:00 WIB</option>
            <option value="13:00">13:00 WIB</option>
            <option value="16:00">16:00 WIB</option>
            <option value="19:00">19:00 WIB</option>
          </select>
        </div>
      </div>

      <div class="bg-[#120722] p-3 rounded-2xl border border-[#FF4B91]/20 mt-3">
        <h3 class="text-xs font-bold text-[#FF93C4] border-b border-[#FF4B91]/20 pb-1 mb-2">Rincian Pesanan</h3>
        <div id="cart-list" class="space-y-1 text-xs text-[#C8B3E6]">
          <p class="italic text-center py-2 text-[#8B74A8]">Belum ada menu yang dipilih</p>
        </div>
      </div>

      <!-- Total Harga -->
      <div class="bg-gradient-to-r from-[#FF4B91] to-[#FF93C4] text-white p-3.5 rounded-2xl border border-[#FF4B91]/40 flex justify-between items-center shadow-[0_0_15px_rgba(255,75,145,0.3)]">
        <span class="font-bold text-sm text-white/90">Total Pembayaran</span>
        <span id="grand-total" class="font-black text-xl text-[#FFD000] drop-shadow-[0_0_5px_rgba(255,208,0,0.6)]">Rp 0</span>
      </div>

      <!-- Tombol WA -->
      <button type="submit" class="w-full py-3 bg-[#25D366] hover:bg-[#20ba59] text-white font-bold rounded-2xl transition-all shadow-[0_0_15px_rgba(37,211,102,0.4)] text-sm flex items-center justify-center gap-2 active:scale-95">
        <span>💬</span> Pesan Sekarang (WhatsApp)
      </button>
    </form>
  </div>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const SUPABASE_URL = "https://mnpoxmxslqrqsgcfbssv.supabase.co";
    const SUPABASE_KEY = "sb_publishable_a_BfJEtkxjstZ1rBucJMww_uVyO0XuR";

    const supabase = window.supabase ? window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY) : null;

    const cart = {};
    
    const productsData = [
      { id: "tahu-kocek", name: "Tahu Kocek", hasVariants: true },
      { id: "tempura-kocek", name: "Tempura Kocek", price: 10000, hasVariants: false },
      { id: "tempura-bintang-chili-oil", name: "Tempura Bintang Chili Oil", price: 10000, hasVariants: false },
      { id: "basreng-chili-oil", name: "Basreng Chili Oil", price: 10000, hasVariants: false },
      { id: "cireng-ayamsuwir", name: "Cireng Isi Ayam Suwir", price: 10000, hasVariants: false },
      { id: "cireng-kuah-creamy", name: "Cireng Kuah Keju Creamy", price: 12000, hasVariants: false },
      { id: "dimsum-kuah-creamy", name: "Dimsum Kuah Keju Creamy", price: 13000, hasVariants: false },
      { id: "bananaroll", name: "Banana Roll", price: 10000, hasGlazeTopping: true },
      { id: "cheeseroll", name: "Cheese Roll", price: 10000, hasGlazeTopping: true },
      { id: "bolubi-keju", name: "Bola Ubi Keju Lumer", price: 10000, hasGlazeTopping: true },
      { id: "bolubi-cokelat", name: "Bola Ubi Cokelat Lumer", price: 10000, hasGlazeTopping: true },
    ];

    function getSelectedVariantData(productId) {
      const selectEl = document.getElementById('variant-select-' + productId);
      if (selectEl) {
        const selectedOption = selectEl.options[selectEl.selectedIndex];
        return {
          variantId: selectEl.value,
          name: selectedOption.getAttribute('data-name') || '',
          price: Number(selectedOption.getAttribute('data-price')) || 0
        };
      }
      return null;
    }

    function getGlazeToppingData(productId) {
      const glaze1El = document.getElementById('glaze1-select-' + productId);
      const glaze2El = document.getElementById('glaze2-select-' + productId);
      const toppingCbs = document.querySelectorAll(`input[name="topping-${productId}"]:checked`);
      
      const glazes = [];
      if (glaze1El && glaze1El.value) glazes.push(glaze1El.value);
      if (glaze2El && glaze2El.value) glazes.push(glaze2El.value);

      const toppings = [];
      toppingCbs.forEach(cb => toppings.push(cb.value));

      // Kalkulasi Otomatis:
      // 1 topping pertama = gratis (include harga dasar 10rb)
      // Topping ke-2 dst = +2.000 per pcs
      const extraToppingCount = Math.max(0, toppings.length - 1);
      const extraToppingFee = extraToppingCount * 2000;

      const glazeStr = glazes.length > 0 ? glazes.join(' + ') : 'Tanpa Glaze';
      const toppingStr = toppings.length > 0 ? toppings.join(', ') : 'Tanpa Topping';

      return {
        keySuffix: `-${glazes.join('_')}-${toppings.join('_')}`,
        detailText: `(Glaze: ${glazeStr} | Topping: ${toppingStr})`,
        calculatedPrice: 10000 + extraToppingFee
      };
    }

    function updateCardPriceDisplay(productId) {
      const product = productsData.find(p => p.id === productId);
      if (!product || !product.hasGlazeTopping) return;

      const glazeTopping = getGlazeToppingData(productId);
      const priceDisplayEl = document.getElementById(`price-display-${productId}`);
      
      if (priceDisplayEl) {
        priceDisplayEl.innerText = `Rp ${glazeTopping.calculatedPrice.toLocaleString('id-ID')}`;
      }
    }

    function syncProductCart(productId) {
      const product = productsData.find(p => p.id === productId);
      if (!product) return;

      updateCardPriceDisplay(productId);

      const qtyCountEl = document.querySelector(`.qty-count[data-id="${productId}"]`);
      const currentQty = qtyCountEl ? parseInt(qtyCountEl.textContent || '0') : 0;

      if (currentQty > 0) {
        for (const k in cart) {
          if (k.startsWith(productId)) delete cart[k];
        }

        if (product.hasGlazeTopping) {
          const glazeTopping = getGlazeToppingData(productId);
          const cartKey = `${productId}${glazeTopping.keySuffix}`;
          cart[cartKey] = {
            id: cartKey,
            name: `${product.name} ${glazeTopping.detailText}`,
            price: glazeTopping.calculatedPrice,
            qty: currentQty
          };
        }
        updateCartUI();
      }
    }

    function updateCartUI() {
      const cartList = document.getElementById('cart-list');
      const grandTotalEl = document.getElementById('grand-total');
      let total = 0;
      let itemsHTML = '';

      for (const key in cart) {
        const item = cart[key];
        if (item.qty > 0) {
          const subtotal = item.price * item.qty;
          total += subtotal;
          itemsHTML += `
            <div class="flex justify-between items-center py-1 border-b border-[#FF4B91]/10">
              <span class="font-medium text-white">${item.name} <span class="text-[#FFD000] font-bold">x${item.qty}</span></span>
              <span class="font-bold text-[#FF93C4]">Rp ${subtotal.toLocaleString('id-ID')}</span>
            </div>
          `;
        }
      }

      if (cartList) {
        cartList.innerHTML = itemsHTML === '' ? '<p class="italic text-center py-2 text-[#8B74A8]">Belum ada menu yang dipilih</p>' : itemsHTML;
      }
      if (grandTotalEl) {
        grandTotalEl.innerText = `Rp ${total.toLocaleString('id-ID')}`;
      }
    }

    // Event listener saat user nyentang/lepas topping atau ubah glaze
    document.querySelectorAll('.topping-cb, .glaze-select').forEach(element => {
      element.addEventListener('change', (e) => {
        const productId = e.target.getAttribute('data-id');
        if (productId) {
          syncProductCart(productId);
        }
      });
    });

    // Tombol (+)
    document.querySelectorAll('.btn-plus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const id = target.getAttribute('data-id');
        const hasVariant = target.getAttribute('data-has-variant') === 'true';
        const hasGlaze = target.getAttribute('data-has-glaze') === 'true';

        if (!id) return;

        let cartKey = id;
        let name = '';
        let price = 0;

        const product = productsData.find(p => p.id === id);

        if (hasVariant) {
          const variantData = getSelectedVariantData(id);
          if (variantData) {
            cartKey = variantData.variantId;
            name = variantData.name;
            price = variantData.price;
          }
        } else if (hasGlaze) {
          const glazeTopping = getGlazeToppingData(id);
          if (glazeTopping && product) {
            cartKey = `${id}${glazeTopping.keySuffix}`;
            name = `${product.name} ${glazeTopping.detailText}`;
            price = glazeTopping.calculatedPrice;
          }
        } else {
          if (product) {
            name = product.name;
            price = product.price || 0;
          }
        }

        if (!cart[cartKey]) {
          cart[cartKey] = { id: cartKey, name, price, qty: 0 };
        }
        cart[cartKey].qty += 1;

        let totalProductQty = 0;
        for (const k in cart) {
          if (k.startsWith(id)) totalProductQty += cart[k].qty;
        }

        const qtyEl = document.querySelector(`.qty-count[data-id="${id}"]`);
        if (qtyEl) qtyEl.textContent = String(totalProductQty);

        updateCartUI();
      });
    });

    // Tombol (-)
    document.querySelectorAll('.btn-minus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const id = target.getAttribute('data-id');

        if (!id) return;

        let matchingKey = Object.keys(cart).reverse().find(k => k.startsWith(id) && cart[k].qty > 0);

        if (matchingKey && cart[matchingKey]) {
          cart[matchingKey].qty -= 1;
          if (cart[matchingKey].qty === 0) delete cart[matchingKey];
        }

        let totalProductQty = 0;
        for (const k in cart) {
          if (k.startsWith(id)) totalProductQty += cart[k].qty;
        }

        const qtyEl = document.querySelector(`.qty-count[data-id="${id}"]`);
        if (qtyEl) qtyEl.textContent = String(totalProductQty);

        updateCartUI();
      });
    });

    // Filter Kategori
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        document.querySelectorAll('.filter-btn').forEach(b => {
          b.classList.remove('bg-[#FF4B91]', 'text-white', 'shadow-[0_0_10px_#FF4B91]');
          b.classList.add('text-[#C8B3E6]');
        });
        target.classList.remove('text-[#C8B3E6]');
        target.classList.add('bg-[#FF4B91]', 'text-white', 'shadow-[0_0_10px_#FF4B91]');

        const filter = target.getAttribute('data-filter');
        document.querySelectorAll('.product-item').forEach(item => {
          if (filter === 'all' || item.getAttribute('data-category') === filter) {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });

    // Submit Order Form
    const form = document.getElementById('order-form');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('custName')?.value || '';
        const phone = document.getElementById('custPhone')?.value || '';
        const address = document.getElementById('custAddress')?.value || '';
        const date = document.getElementById('orderDate')?.value || '';
        const time = document.getElementById('orderTime')?.value || '';

        let orderItemsText = '';
        let orderItemsSummary = [];
        let total = 0;

        for (const key in cart) {
          const item = cart[key];
          if (item.qty > 0) {
            orderItemsText += `- ${item.name} (${item.qty}x) : Rp ${(item.price * item.qty).toLocaleString('id-ID')}\n`;
            orderItemsSummary.push(`${item.name} (${item.qty}x)`);
            total += item.price * item.qty;
          }
        }

        if (total === 0) {
          alert('Pilih minimal 1 menu jajan dulu ya!');
          return;
        }

        if (supabase) {
          try {
            const { error } = await supabase
              .from('pesanan')
              .insert([
                { 
                  nama: name, 
                  telepon: phone, 
                  alamat: address,
                  tanggal_kirim: `${date} (${time})`,
                  pesanan: orderItemsSummary.join(', '), 
                  total: `Rp ${total.toLocaleString('id-ID')}` 
                }
              ]);

            if (error) console.error('Error Supabase:', error.message);
          } catch (err) {
            console.error('Gagal simpan:', err);
          }
        }

        const waText = `Halo Mimin! Ada pesanan baru nih 😋:\n\n` +
          `*Nama:* ${name}\n` +
          `*No HP:* ${phone}\n` +
          `*Alamat:* ${address}\n` +
          `*Waktu Kirim:* ${date} jam ${time}\n\n` +
          `*Pesanan:*\n${orderItemsText}\n` +
          `*Total Pembayaran:* Rp ${total.toLocaleString('id-ID')}\n\n` +
          `Mohon diproses ya min, makasih!`;

        const adminWA = "6285755534178";
        window.open(`https://wa.me/${adminWA}?text=${encodeURIComponent(waText)}`, '_blank');
      });
    }
  });
</script>