---
import Layout from "../layouts/Layout.astro";
import Catalog from "../components/ui/catalog.astro";
---

<Layout title="Jajanan Gen Z by Mimin - Katalog & Pemesanan">
  <main class="max-w-6xl mx-auto px-4 py-8 font-['Fredoka']">
    <div class="text-center mb-8">
      <div class="inline-block px-4 py-1.5 rounded-full bg-[#FF4B91]/20 border border-[#FF4B91] text-[#FF93C4] text-xs font-bold uppercase tracking-wider mb-3 shadow-[0_0_10px_rgba(255,75,145,0.3)]">
        NYEMIL DULU, DIETNYA BESOK AJA
      </div>

      <h1 class="text-3xl md:text-5xl font-black text-white tracking-wide drop-shadow-[0_0_15px_rgba(255,75,145,0.5)] leading-tight [font-family:'Stout_Deco','Fredoka',sans-serif]">
        Jajanan Gen Z <span class="text-[#FF4B91]">by Mimin</span>
      </h1>

      <p class="text-[#C8B3E6] mt-2 text-sm md:text-base font-medium">
        Pilih menu favoritmu dan isi data buat order via WhatsApp!
      </p>
    </div>

    <!-- Katalog Produk -->
    <Catalog />
  </main>
</Layout>