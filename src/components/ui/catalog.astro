---
const products = [
  {
    id: "tahu-kocek",
    name: "Tahu Kocek",
    category: "asin",
    hasVariants: true,
    variants: [
      { id: "tahu-kocek-kecil", name: "Kecil", price: 7000 },
      { id: "tahu-kocek-besar", name: "Besar", price: 10000 },
    ],
    desc: "Pilih porsi nyemil pas atau porsi puas!",
    badge: "Best Seller 🔥",
  },
  {
    id: "tempura-kocek",
    name: "Tempura Kocek",
    category: "asin",
    price: 10000,
    desc: "Tempura gurih dengan bumbu sambal kocek",
    badge: "Pedas 🌶️",
  },
  {
    id: "tempura-bintang-chili-oil",
    name: "Tempura Bintang Chili Oil",
    category: "asin",
    price: 10000,
    desc: "Tempura pedas gurih dengan chili oil",
    badge: "Favorit 🧀",
  },
  {
    id: "basreng-chili-oil",
    name: "Basreng Chili Oil",
    category: "asin",
    price: 10000,
    desc: "Jajanan basreng pedas gurih dengan chili oil",
    badge: "Hemat 💡",
  },
  {
    id: "cireng-ayamsuwir",
    name: "Cireng Isi Ayam Suwir",
    category: "asin",
    price: 10000,
    desc: "Porsi pas buat nyemil",
    badge: "Hemat 💡",
  },
  {
    id: "cireng-kuah-creamy",
    name: "Cireng Kuah Keju Creamy",
    category: "asin",
    price: 12000,
    desc: "Porsi pas buat nyemil",
    badge: "Hemat 💡",
  },
  {
    id: "dimsum-kuah-creamy",
    name: "Dimsum Kuah Keju Creamy",
    category: "asin",
    price: 13000,
    desc: "Porsi pas buat nyemil",
    badge: "Hemat 💡",
  },
  {
    id: "pancake-cokelat",
    name: "Pancake Cokelat Lumer",
    category: "manis",
    price: 12000,
    desc: "Manis legit topping melimpah",
    badge: "Manis 🍫",
  },
  {
    id: "pisang-keju",
    name: "Pisang Keju Susu",
    category: "manis",
    price: 10000,
    desc: "Crispy di luar lembut di dalam",
    badge: "Lumer ✨",
  },
];
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start font-['Fredoka']">
  <!-- KOLOM KIRI: MENU -->
  <div class="lg:col-span-7 bg-[#FFF2E2] p-5 rounded-3xl border-2 border-[#4A2E17] shadow-[4px_4px_0px_0px_#4A2E17]">
    
    <!-- Header & Filter -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-3 border-b-2 border-dashed border-[#FFB800]">
      <div>
        <h2 class="text-2xl font-bold text-[#4A2E17] flex items-center gap-2">
          <span>🍿</span> Step 1: Pilih Jajanan
        </h2>
        <p class="text-xs text-[#7A5230] font-medium mt-0.5">
          Klik (+/-) di katalog buat masukin menu ke keranjang!
        </p>
      </div>
      <div class="flex gap-2" id="filter-container">
        <button data-filter="all" class="filter-btn active-filter px-4 py-1.5 text-xs font-bold rounded-full border-2 border-[#4A2E17] bg-[#FFB800] text-[#4A2E17] shadow-[2px_2px_0px_0px_#4A2E17] transition-all">All</button>
        <button data-filter="asin" class="filter-btn px-4 py-1.5 text-xs font-bold rounded-full border-2 border-[#4A2E17] bg-white text-[#4A2E17] shadow-[2px_2px_0px_0px_#4A2E17] transition-all">Asin</button>
        <button data-filter="manis" class="filter-btn px-4 py-1.5 text-xs font-bold rounded-full border-2 border-[#4A2E17] bg-white text-[#4A2E17] shadow-[2px_2px_0px_0px_#4A2E17] transition-all">Manis</button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {products.map((item) => (
        <div class="product-item bg-white p-4 rounded-2xl border-2 border-[#4A2E17] shadow-[3px_3px_0px_0px_#4A2E17] flex flex-col justify-between" data-category={item.category}>
          <div>
            <div class="relative bg-[#FFF9F2] border-2 border-[#4A2E17] rounded-xl h-28 flex items-center justify-center font-bold text-lg text-[#7A5230] mb-3 overflow-hidden text-center px-2">
              <span class="z-10">{item.name}</span>
              <span class="absolute top-2 right-2 bg-[#FF729F] text-white text-[10px] font-bold px-2 py-0.5 rounded-full border border-[#4A2E17]">
                {item.badge}
              </span>
            </div>

            <h3 class="font-bold text-[#4A2E17] text-base leading-snug">{item.name}</h3>
            <p class="text-xs text-[#7A5230] mt-1 font-medium">{item.desc}</p>
            
            {item.hasVariants ? (
              <div class="mt-3 bg-[#FFF9F2] p-2 rounded-xl border-2 border-[#4A2E17]">
                <label class="block text-[11px] font-bold text-[#4A2E17] mb-1">Pilih Porsi / Ukuran:</label>
                <select id={`variant-select-${item.id}`} class="variant-select w-full p-1.5 text-xs font-bold rounded-lg border border-[#4A2E17] bg-white text-[#4A2E17] focus:outline-none">
                  {item.variants?.map((v) => (
                    <option value={v.id} data-price={v.price} data-name={`${item.name} (${v.name})`}>
                      Porsi {v.name} - Rp {v.price.toLocaleString("id-ID")}
                    </option>
                  ))}
                </select>
              </div>
            ) : (
              <p class="text-sm font-black text-[#FF5D42] mt-2">Rp {item.price?.toLocaleString("id-ID")}</p>
            )}
          </div>

          <!-- Counter Qty -->
          <div class="flex items-center justify-between mt-4 bg-[#FFF9F2] p-1.5 rounded-xl border border-[#4A2E17]">
            <button class="btn-minus w-8 h-8 rounded-lg border border-[#4A2E17] bg-white text-[#4A2E17] font-bold shadow-[1px_1px_0px_0px_#4A2E17] active:translate-y-0.5" data-id={item.id} data-has-variant={item.hasVariants ? "true" : "false"}>-</button>
            <span class="qty-count font-bold text-[#4A2E17] text-sm" data-id={item.id}>0</span>
            <button class="btn-plus w-8 h-8 rounded-lg border border-[#4A2E17] bg-[#FFB800] text-[#4A2E17] font-bold shadow-[1px_1px_0px_0px_#4A2E17] active:translate-y-0.5" data-id={item.id} data-has-variant={item.hasVariants ? "true" : "false"}>+</button>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- KOLOM KANAN: DATA PESANAN -->
  <div class="lg:col-span-5 bg-[#FFF2E2] p-5 rounded-3xl border-2 border-[#4A2E17] shadow-[4px_4px_0px_0px_#4A2E17] space-y-4">
    <div class="border-b-2 border-dashed border-[#FFB800] pb-3">
      <h2 class="text-2xl font-bold text-[#4A2E17] flex items-center gap-2">
        <span>📋</span> Step 2: Lengkapi Data
      </h2>
      <p class="text-xs text-[#7A5230] font-medium mt-0.5">
        Isi form pengiriman, lalu klik tombol WA buat checkout!
      </p>
    </div>

    <form id="order-form" class="space-y-3">
      <div>
        <label class="block text-xs font-bold text-[#4A2E17] mb-1">Nama Pemesan</label>
        <input type="text" id="custName" required placeholder="Nama kamu..." class="w-full px-3 py-2 text-sm rounded-xl border-2 border-[#4A2E17] bg-white text-[#4A2E17] focus:outline-none focus:ring-2 focus:ring-[#FFB800]" />
      </div>

      <div>
        <label class="block text-xs font-bold text-[#4A2E17] mb-1">Nomor Telepon</label>
        <input type="tel" id="custPhone" required placeholder="08xxxxxxxxxx" class="w-full px-3 py-2 text-sm rounded-xl border-2 border-[#4A2E17] bg-white text-[#4A2E17] focus:outline-none focus:ring-2 focus:ring-[#FFB800]" />
      </div>

      <div>
        <label class="block text-xs font-bold text-[#4A2E17] mb-1">Alamat Pemesanan</label>
        <textarea id="custAddress" required rows="2" placeholder="Jl. Raya No. 12..." class="w-full px-3 py-2 text-sm rounded-xl border-2 border-[#4A2E17] bg-white text-[#4A2E17] focus:outline-none focus:ring-2 focus:ring-[#FFB800]"></textarea>
      </div>

      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="block text-xs font-bold text-[#4A2E17] mb-1">Tanggal Kirim</label>
          <input type="date" id="orderDate" required class="w-full px-2 py-2 text-xs rounded-xl border-2 border-[#4A2E17] bg-white text-[#4A2E17] focus:outline-none" />
        </div>
        <div>
          <label class="block text-xs font-bold text-[#4A2E17] mb-1">Jam Kirim (WIB)</label>
          <select id="orderTime" required class="w-full px-2 py-2 text-xs rounded-xl border-2 border-[#4A2E17] bg-white text-[#4A2E17] focus:outline-none">
            <option value="">Pilih Jam</option>
            <option value="10:00">10:00 WIB</option>
            <option value="13:00">13:00 WIB</option>
            <option value="16:00">16:00 WIB</option>
            <option value="19:00">19:00 WIB</option>
          </select>
        </div>
      </div>

      <div class="bg-white p-3 rounded-2xl border-2 border-[#4A2E17] mt-3">
        <h3 class="text-xs font-bold text-[#4A2E17] border-b pb-1 mb-2">Rincian Pesanan</h3>
        <div id="cart-list" class="space-y-1 text-xs text-[#7A5230]">
          <p class="italic text-center py-2">Belum ada menu yang dipilih</p>
        </div>
      </div>

      <div class="bg-[#FF5D42] text-white p-3 rounded-2xl border-2 border-[#4A2E17] shadow-[2px_2px_0px_0px_#4A2E17] flex justify-between items-center">
        <span class="font-bold text-sm">Total Pembayaran</span>
        <span id="grand-total" class="font-black text-lg">Rp 0</span>
      </div>

      <button type="submit" class="w-full py-3 bg-[#25D366] text-white font-bold rounded-2xl border-2 border-[#4A2E17] shadow-[3px_3px_0px_0px_#4A2E17] hover:bg-[#20ba59] active:translate-y-0.5 transition-all text-sm flex items-center justify-center gap-2">
        <span>💬</span> Pesan Sekarang (WhatsApp)
      </button>
    </form>
  </div>
</div>

<script>
  interface CartItem {
    id: string;
    name: string;
    price: number;
    qty: number;
  }

  const cart: Record<string, CartItem> = {};
  
  const productsData = [
    { id: "tahu-kocek", name: "Tahu Kocek", hasVariants: true },
    { id: "tempura-kocek", name: "Tempura Kocek", price: 10000, hasVariants: false },
    { id: "tempura-bintang-chili-oil", name: "Tempura Bintang Chili Oil", price: 10000, hasVariants: false },
    { id: "basreng-chili-oil", name: "Basreng Chili Oil", price: 10000, hasVariants: false },
    { id: "cireng-ayamsuwir", name: "Cireng Isi Ayam Suwir", price: 10000, hasVariants: false },
    { id: "cireng-kuah-creamy", name: "Cireng Kuah Keju Creamy", price: 12000, hasVariants: false },
    { id: "dimsum-kuah-creamy", name: "Dimsum Kuah Keju Creamy", price: 13000, hasVariants: false },
    { id: "pancake-cokelat", name: "Pancake Cokelat Lumer", price: 12000, hasVariants: false },
    { id: "pisang-keju", name: "Pisang Keju Susu", price: 10000, hasVariants: false },
  ];

  function getSelectedVariantData(productId: string) {
    const selectEl = document.getElementById(`variant-select-${productId}`) as HTMLSelectElement | null;
    if (selectEl) {
      const selectedOption = selectEl.options[selectEl.selectedIndex];
      return {
        variantId: selectEl.value,
        name: selectedOption.getAttribute('data-name') || '',
        price: Number(selectedOption.getAttribute('data-price')) || 0
      };
    }
    return null;
  }

  function updateCartUI() {
    const cartList = document.getElementById('cart-list');
    const grandTotalEl = document.getElementById('grand-total');
    let total = 0;
    let itemsHTML = '';

    for (const key in cart) {
      const item = cart[key];
      if (item.qty > 0) {
        const subtotal = item.price * item.qty;
        total += subtotal;
        itemsHTML += `
          <div class="flex justify-between items-center py-1 border-b border-dashed border-gray-200">
            <span class="font-medium">${item.name} x${item.qty}</span>
            <span class="font-bold">Rp ${subtotal.toLocaleString('id-ID')}</span>
          </div>
        `;
      }
    }

    if (cartList) {
      cartList.innerHTML = itemsHTML === '' ? '<p class="italic text-center py-2">Belum ada menu yang dipilih</p>' : itemsHTML;
    }
    if (grandTotalEl) {
      grandTotalEl.innerText = `Rp ${total.toLocaleString('id-ID')}`;
    }
  }

  document.querySelectorAll('.btn-plus').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const id = target.getAttribute('data-id');
      const hasVariant = target.getAttribute('data-has-variant') === 'true';

      if (!id) return;

      let cartKey = id;
      let name = '';
      let price = 0;

      if (hasVariant) {
        const variantData = getSelectedVariantData(id);
        if (variantData) {
          cartKey = variantData.variantId;
          name = variantData.name;
          price = variantData.price;
        }
      } else {
        const product = productsData.find(p => p.id === id);
        if (product) {
          name = product.name;
          price = product.price || 0;
        }
      }

      if (!cart[cartKey]) {
        cart[cartKey] = { id: cartKey, name, price, qty: 0 };
      }
      cart[cartKey].qty += 1;

      let totalProductQty = 0;
      for (const k in cart) {
        if (k.startsWith(id)) totalProductQty += cart[k].qty;
      }

      const qtyEl = document.querySelector(`.qty-count[data-id="${id}"]`);
      if (qtyEl) qtyEl.textContent = String(totalProductQty);

      updateCartUI();
    });
  });

  document.querySelectorAll('.btn-minus').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const id = target.getAttribute('data-id');
      const hasVariant = target.getAttribute('data-has-variant') === 'true';

      if (!id) return;

      let cartKey = id;

      if (hasVariant) {
        const variantData = getSelectedVariantData(id);
        if (variantData) cartKey = variantData.variantId;
      }

      if (cart[cartKey] && cart[cartKey].qty > 0) {
        cart[cartKey].qty -= 1;
        if (cart[cartKey].qty === 0) delete cart[cartKey];
      }

      let totalProductQty = 0;
      for (const k in cart) {
        if (k.startsWith(id)) totalProductQty += cart[k].qty;
      }

      const qtyEl = document.querySelector(`.qty-count[data-id="${id}"]`);
      if (qtyEl) qtyEl.textContent = String(totalProductQty);

      updateCartUI();
    });
  });

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('bg-[#FFB800]');
        b.classList.add('bg-white');
      });
      target.classList.remove('bg-white');
      target.classList.add('bg-[#FFB800]');

      const filter = target.getAttribute('data-filter');
      document.querySelectorAll('.product-item').forEach(item => {
        const el = item as HTMLElement;
        if (filter === 'all' || el.getAttribute('data-category') === filter) {
          el.style.display = 'flex';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });

  const form = document.getElementById('order-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('custName') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('custPhone') as HTMLInputElement)?.value || '';
      const address = (document.getElementById('custAddress') as HTMLTextAreaElement)?.value || '';
      const date = (document.getElementById('orderDate') as HTMLInputElement)?.value || '';
      const time = (document.getElementById('orderTime') as HTMLSelectElement)?.value || '';

      let orderItems = '';
      let total = 0;
      for (const key in cart) {
        const item = cart[key];
        if (item.qty > 0) {
          orderItems += `- ${item.name} (${item.qty}x) : Rp ${(item.price * item.qty).toLocaleString('id-ID')}\n`;
          total += item.price * item.qty;
        }
      }

      if (total === 0) {
        alert('Pilih minimal 1 menu jajan dulu ya!');
        return;
      }

      const waText = `Halo Mimin! Ada pesanan baru nih 😋:\n\n` +
        `*Nama:* ${name}\n` +
        `*No HP:* ${phone}\n` +
        `*Alamat:* ${address}\n` +
        `*Waktu Kirim:* ${date} jam ${time}\n\n` +
        `*Pesanan:*\n${orderItems}\n` +
        `*Total Pembayaran:* Rp ${total.toLocaleString('id-ID')}\n\n` +
        `Mohon diproses ya min, makasih!`;

      const adminWA = "6281234567890";
      window.open(`https://wa.me/${adminWA}?text=${encodeURIComponent(waText)}`, '_blank');
    });
  }
</script>