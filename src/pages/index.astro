---
import Layout from "../layouts/Layout.astro";
import Catalog from "../components/ui/catalog.astro";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=Righteous&display=swap"
  rel="stylesheet"
/>

<Layout title="Jajanan Gen Z by Mimin - Katalog & Pemesanan">
  <main class="max-w-6xl mx-auto px-4 py-8 font-['Outfit'] relative">
    
    <div class="mb-8 relative max-w-3xl mx-auto text-center">
      
      <!-- Background Glow Effect -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] sm:w-[450px] h-[150px] bg-[#FF4B91]/20 blur-[90px] rounded-full pointer-events-none -z-10"></div>

      <!-- Badge Slogan -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#24113B]/90 border border-[#FF4B91]/50 text-[#FF93C4] text-xs font-black uppercase tracking-widest shadow-[0_0_15px_rgba(255,75,145,0.3)] mb-4">
        <span>✨ NYEMIL DULU, DIETNYA BESOK AJA ✨</span>
      </div>

      <!-- Main Headline (Rata Tengah Atas Bawah) -->
      <div class="flex flex-col items-center justify-center leading-none select-none">
        <!-- Baris 1: JAJANAN GEN Z -->
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-['Righteous'] text-white uppercase tracking-wide drop-shadow-[0_4px_25px_rgba(255,75,145,0.4)]">
          JAJANAN GEN Z
        </h1>
        
        <!-- Baris 2: by Mimin -->
        <div class="mt-1 sm:mt-2">
          <span class="text-2xl sm:text-4xl md:text-5xl text-transparent bg-clip-text bg-gradient-to-r from-[#FF4B91] via-[#FF93C4] to-[#FFD000] font-['Outfit'] font-[900] italic uppercase tracking-tight drop-shadow-[0_4px_20px_rgba(255,75,145,0.3)]">
            by Mimin
          </span>
        </div>
      </div>

      <!-- Subtitle -->
      <p class="text-[#C8B3E6] mt-4 text-center text-sm md:text-base font-medium max-w-lg mx-auto leading-relaxed">
        Pilih menu favoritmu dan isi data buat order via WhatsApp! 🚀
      </p>

    </div>

    <!-- Katalog Produk -->
    <Catalog />
  </main>
</Layout>