---
import Layout from "../layouts/Layout.astro";
import Catalog from "../components/ui/catalog.astro";
---

<Layout title="Jajanan Gen Z by Mimin - Katalog & Pemesanan">
  <main class="max-w-6xl mx-auto px-4 py-8">
    <div class="text-center mb-8">
      <div class="inline-block bg-[#FF5D42] text-white px-4 py-1 rounded-full text-xs font-bold tracking-wider uppercase mb-2 shadow-[2px_2px_0px_0px_#4A2E17] border border-[#4A2E17]">
        🔥 Nyemil dulu, dietnya besok aja
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-[#4A2E17] tracking-wide drop-shadow-sm">
        Jajanan Gen Z <span class="text-[#FF5D42]">by Mimin</span>
      </h1>
      <p class="text-[#7A5230] mt-2 text-sm md:text-base font-medium">
        Pilih menu favoritmu dan isi data buat order via WhatsApp! ✨
      </p>
    </div>

    <!-- Katalog Produk -->
    <Catalog />
  </main>
</Layout>