<header class="navbar-header">
  <div class="navbar-container">
    <!-- Logo Kiri -->
    <a href="/" class="navbar-brand">
      <span class="brand-bold">Astro</span><span class="brand-light">ship</span>
    </a>

    <!-- Link Contact Kanan -->
    <div class="navbar-nav">
      <a href="/contact" class="nav-link">Contact</a>
    </div>
  </div>
</header>

<style>
  .navbar-header {
    width: 100%;
    background-color: transparent;
    padding: 20px 0;
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .navbar-brand {
    font-size: 20px;
    font-weight: 700;
    text-decoration: none;
    color: #0f172a;
  }

  .brand-bold {
    font-weight: 800;
    color: #0f172a;
  }

  .brand-light {
    font-weight: 400;
    color: #64748b;
  }

  .nav-link {
    font-size: 15px;
    font-weight: 500;
    color: #334155;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: #0f172a;
  }
</style>