---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import "../styles/global.css";

export interface Props {
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  "/opengraph.jpg",
  Astro.site
).toString();

const { title } = Astro.props;

const makeTitle = title
  ? title + " | " + "Jajanan Gen Z by Mimin"
  : "Jajanan Gen Z by Mimin - Katalog Pesanan";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">

    <SEO
      title={makeTitle}
      description="Katalog resmi Jajanan Gen Z by Mimin. Pilih menu favoritmu dan pesan langsung via WhatsApp!"
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `Jajanan Gen Z by Mimin`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Jajanan Gen Z Screenshot",
        },
      }}
    />
  </head>
  <body class="bg-[#FFF9F2] text-[#4A2E17] font-['Fredoka',sans-serif] antialiased">
    <Navbar />
    <slot />
    <Footer />
    
    <style is:global>
      body {
        font-family: 'Fredoka', cursive, sans-serif;
      }

      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>